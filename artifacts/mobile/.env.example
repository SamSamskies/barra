# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Get your authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Claim a free static domain at https://dashboard.ngrok.com/cloud-edge/domains
# When both are set AND the ngrok CLI v3+ is on your PATH (brew install ngrok),
# the tunnel URL stays the same across restarts (prevents progress loss).
NGROK_STATIC_DOMAIN=
